    <!DOCTYPE html>
    <html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Proyectos Académicos</title>
        <link rel="icon" type="image/png" href="https://www.capouilliez.edu.gt/assets/img/logo.png">

        <style>
            /* Variables de color - Paleta Morada */
            :root {
                --bg-principal: #f3f0f7;
                --card-bg: #ffffff;
                --text-dark: #2a1b3d;
                --text-muted: #6e5e85;
                --purple-primary: #6a1b9a;
                --purple-hover: #4a148c;
                --purple-light: #f3e5f5;
                --border-color: #e1d5e7;
            }

            body {
                margin: 0;
                padding: 0;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background-color: var(--bg-principal);
                color: var(--text-dark);
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }

            /* Encabezado */
            header {
                background-color: #ffffff;
                padding: 20px 40px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                box-shadow: 0 2px 10px rgba(106, 27, 154, 0.08);
                border-bottom: 3px solid var(--purple-primary);
            }

            header h1 {
                margin: 0;
                font-size: 1.8rem;
                color: var(--purple-primary);
            }

            .logo-colegio {
                height: 60px;
                width: auto;
                object-fit: contain;
            }

            /* Contenedor principal */
            main {
                flex: 1;
                max-width: 1100px;
                margin: 40px auto;
                padding: 0 20px;
                width: 100%;
                box-sizing: border-box;
            }

            .subtitulo {
                text-align: center;
                margin-bottom: 40px;
                color: var(--text-muted);
                font-size: 1.1rem;
            }

            /* Cuadrícula de proyectos */
            .grid-proyectos {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
                gap: 25px;
            }

            .card {
                background-color: var(--card-bg);
                border-radius: 16px;
                padding: 25px;
                box-shadow: 0 4px 20px rgba(106, 27, 154, 0.05);
                border: 1px solid var(--border-color);
                border-top: 5px solid var(--purple-primary);
                transition: all 0.3s ease;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
            }

            .card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 25px rgba(106, 27, 154, 0.15);
            }

            .card h2 {
                margin-top: 0;
                font-size: 1.4rem;
                color: var(--purple-primary);
            }

            .card p {
                color: var(--text-muted);
                font-size: 0.9rem;
                line-height: 1.4;
                margin-bottom: 15px;
            }

            /* Espacios para contenido incrustado (PDF, Canva, Video) */
            .visor-contenedor {
                width: 100%;
                height: 250px;
                border-radius: 10px;
                overflow: hidden;
                border: 1px solid var(--border-color);
                background-color: #fafafa;
                margin-bottom: 15px;
            }

            .visor-contenedor iframe, 
            .visor-contenedor video {
                width: 100%;
                height: 100%;
                border: none;
            }

            /* Botones generales */
            .acciones-card {
                display: flex;
                flex-direction: column;
                gap: 10px;
                margin-top: 10px;
            }

            .btn-link {
                display: block;
                padding: 10px 15px;
                background-color: var(--purple-light);
                color: var(--purple-primary);
                text-align: center;
                border-radius: 8px;
                font-weight: 600;
                text-decoration: none;
                transition: all 0.2s ease;
                border: 1px solid var(--border-color);
            }

            .btn-link:hover {
                background-color: var(--purple-primary);
                color: white;
            }

            .btn-autores {
                display: block;
                padding: 12px 20px;
                background: linear-gradient(135deg, var(--purple-primary), var(--purple-hover));
                color: white;
                text-align: center;
                border-radius: 8px;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.2s ease;
                user-select: none;
                box-shadow: 0 4px 10px rgba(106, 27, 154, 0.2);
            }

            .btn-autores:hover {
                transform: scale(1.02);
                box-shadow: 0 6px 14px rgba(106, 27, 154, 0.3);
            }

            /* Pie de página */
            footer {
                text-align: center;
                padding: 20px;
                background-color: #ffffff;
                border-top: 1px solid var(--border-color);
                color: var(--text-muted);
                font-size: 0.9rem;
            }

            /* Modal / Ventana Emergente */
            .modal-overlay {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(42, 27, 61, 0.6);
                backdrop-filter: blur(4px);
                display: flex;
                justify-content: center;
                align-items: center;
                opacity: 0;
                pointer-events: none;
                transition: opacity 0.3s ease;
                z-index: 1000;
            }

            .modal-overlay.active {
                opacity: 1;
                pointer-events: auto;
            }

            .modal-content {
                background-color: #ffffff;
                padding: 30px;
                border-radius: 16px;
                width: 90%;
                max-width: 450px;
                box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
                position: relative;
                transform: scale(0.9);
                transition: transform 0.3s ease;
                border: 1px solid var(--border-color);
            }

            .modal-overlay.active .modal-content {
                transform: scale(1);
            }

            .modal-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                border-bottom: 2px solid var(--purple-light);
                padding-bottom: 15px;
                margin-bottom: 20px;
            }

            .modal-header h3 {
                margin: 0;
                font-size: 1.3rem;
                color: var(--purple-primary);
            }

            .btn-cerrar {
                background: none;
                border: none;
                font-size: 1.5rem;
                cursor: pointer;
                color: var(--text-muted);
            }

            .btn-cerrar:hover {
                color: var(--purple-primary);
            }

            .lista-autores {
                list-style: none;
                padding: 0;
                margin: 0;
            }

            .lista-autores li {
                padding: 12px 15px;
                background-color: var(--purple-light);
                border-radius: 8px;
                margin-bottom: 10px;
                font-weight: 500;
                color: var(--purple-hover);
                display: flex;
                align-items: center;
            }

            .lista-autores li::before {
                content: "•";
                color: var(--purple-primary);
                font-weight: bold;
                font-size: 1.2rem;
                display: inline-block;
                width: 1em;
                margin-left: -0.2em;
            }
        </style>
    </head>
    <body>

        <header>
            <h1>Muestrario de Proyectos</h1>
            <img src="https://www.capouilliez.edu.gt/assets/img/logo.png" alt="Logo Colegio Capouilliez" class="logo-colegio">
        </header>

        <main>
            <p class="subtitulo">Explora los entregables académicos del proyecto de eficiencia energética.</p>

            <div class="grid-proyectos">
                
                <!-- TARJETA 1: DOCUMENTO PDF -->
                <div class="card">
                    <div>
                        <h2>Documento de Investigación</h2>
                        <p>Informe escrito con el marco teórico, problemática e investigación en IRTRA Mundo Petapa.</p>
                        
                        <!-- VISOR DE PDF EMBEBIDO -->
                        <div class="visor-contenedor">
                            <!-- Reemplaza "tu-documento.pdf" por la ruta o enlace de tu archivo PDF -->
                            <iframe src="tu-documento.pdf" title="Visor Documento PDF"></iframe>
                        </div>
                    </div>
                    <div class="acciones-card">
                        <div class="btn-autores" onclick="abrirModal('Documento de Investigación', ['Danae Serech'])">
                            Ver Realizadores
                        </div>
                    </div>
                </div>

                <!-- TARJETA 2: INFOGRAFÍA -->
                <div class="card">
                    <div>
                        <h2>Infografía</h2>
                        <p>Visualización gráfica sobre el desperdicio de energía e impacto ambiental.</p>
                        
                        <!-- VISOR DE INFOGRAFÍA EMBEBIDO -->
                        <div class="visor-contenedor">
                            <!-- Reemplaza la URL del src por el enlace de tu infografía o iframe de Canva -->
                            <iframe src="https://www.canva.com/design/TU_CODIGO/view?embed" allowfullscreen="allowfullscreen" allow="fullscreen"></iframe>
                        </div>
                    </div>
                    <div class="acciones-card">
                        <div class="btn-autores" onclick="abrirModal('Infografía', ['María Reneeé Herrera'])">
                            Ver Realizadores
                        </div>
                    </div>
                </div>

                <!-- TARJETA 3: PODCAST (VIDEO) -->
                <div class="card">
                    <div>
                        <h2>Podcast</h2>
                        <p>Episodio sobre automatización, eficiencia energética y el ODS 7.</p>
                        
                        <!-- CONTENEDOR DE VIDEO DE PODCAST -->
                        <div class="visor-contenedor">
                            <!-- Opción A: Archivo de video local/directo -->
                            <video controls>
                                <source src="tu-video-podcast.mp4" type="video/mp4">
                                Tu navegador no soporta la reproducción de video.0
                            </video>
                            
                            <!-- Opción B: Si usas YouTube, puedes reemplazar la etiqueta <video> anterior por este iframe: -->
                            <!-- <iframe src="https://www.youtube.com/embed/TU_ID_DE_VIDEO" allowfullscreen></iframe> -->
                        </div>
                    </div>
                    <div class="acciones-card">
                        <div class="btn-autores" onclick="abrirModal('Podcast', ['Valeria Marroquín', 'María Reneeé Herrera', 'Danae Serech'])">
                            Ver Realizadores
                        </div>
                    </div>
                </div>

                <!-- TARJETA 4: CIRCUITO ARDUINO (LINK) -->
                <div class="card">
                    <div>
                        <h2>Circuito Tinkercad</h2>
                        <p>Simulación del sistema automatizado con Arduino, sensores PIR, LDR, LED y Buzzer.</p>
                    </div>
                    <div class="acciones-card">
                        <!-- ENLACE DIRECTO AL CIRCUITO -->
                        <a href="https://www.tinkercad.com/things/euUBb0nFnl8/editel?returnTo=%2Fdashboard&sharecode=fX7kBPTuMh58rnz3d7wiFlsCb7XMCuim2qdiqJQwPD4" target="_blank" class="btn-link">⚡ Abrir Circuito en Tinkercad</a>
                        <div class="btn-autores" onclick="abrirModal('Circuito Arduino', ['Valeria Marroquín'])">
                            Ver Realizadores
                        </div>
                    </div>
                </div>

            </div>
        </main>

        <footer>
            @valeriap_marroquín • Colegio Capouilliez
        </footer>

        <!-- Ventana emergente (Modal) -->
        <div class="modal-overlay" id="modalAutores" onclick="cerrarModalAfuera(event)">
            <div class="modal-content">
                <div class="modal-header">
                    <h3 id="modalTitulo">Realizadores</h3>
                    <button class="btn-cerrar" onclick="cerrarModal()">&times;</button>
                </div>
                <ul class="lista-autores" id="modalLista">
                    <!-- Nombres insertados con JavaScript -->
                </ul>
            </div>
        </div>

        <script>
            function abrirModal(titulo, integrantes) {
                document.getElementById('modalTitulo').innerText = 'Realizadores - ' + titulo;
                
                const lista = document.getElementById('modalLista');
                lista.innerHTML = ''; 

                integrantes.forEach(nombre => {
                    const li = document.createElement('li');
                    li.innerText = nombre;
                    lista.appendChild(li);
                });

                document.getElementById('modalAutores').classList.add('active');
            }

            function cerrarModal() {
                document.getElementById('modalAutores').classList.remove('active');
            }

            function cerrarModalAfuera(event) {
                if (event.target.id === 'modalAutores') {
                    cerrarModal();
                }
            }
        </script>

    </body>
    </html>
